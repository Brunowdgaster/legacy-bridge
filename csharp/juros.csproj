<Project Sdk="Microsoft.NET.Sdk">

  <!-- O destino da migração: C# moderno, com o rigor ligado.

       `TreatWarningsAsErrors` é a mesma política do porte em F# do
       p02-forge-lang. Num projeto cuja prova é comparação byte a byte, um
       aviso ignorado é uma divergência esperando acontecer.

       `Nullable` ligado porque `ProcessaComDecimal` devolve `string?` em
       caso de tipo inválido, e o compilador obriga a tratar, em vez de
       deixar um `null` chegar ao `WriteLine`. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>juros</AssemblyName>
    <RootNamespace>LegacyBridge</RootNamespace>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

</Project>
