<Project Sdk="Microsoft.NET.Sdk">

  <!-- A primeira etapa de migração, com o rigor ligado.

       `OptionStrict` e `OptionExplicit` ligados fazem o compilador recusar
       conversão implícita que perde dados e variável não declarada.

       Com `Option Strict Off`, que é o padrão histórico do VB, a linguagem
       converte String para Double em silêncio. É assim que migração de VB6
       vira um sistema que erra centavo, e num projeto sobre dinheiro ligar os
       dois não é preferência: é requisito. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>juros-vb</AssemblyName>
    <RootNamespace>LegacyBridge</RootNamespace>
    <StartupObject>LegacyBridge.Juros</StartupObject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>Off</OptionInfer>
  </PropertyGroup>

</Project>
